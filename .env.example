# ==========================================
# PRIMARY: Mistral AI (Cloud)
# ==========================================
# Get your API key from: https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

# Mistral model to use
# Options: mistral-large-latest, mistral-medium-latest, mistral-small-latest
MISTRAL_MODEL=mistral:latest 
LLM_PROVIDER=ollama
OLLAMA_MODEL=mistral
OLLAMA_BASE_URL=http://localhost:11434

# ==========================================
# LLM Provider Setting
# ==========================================
# Default: mistral (cloud API)
# Alternative: ollama (local, no API key needed)
LLM_PROVIDER=mistral

# ==========================================
# ALTERNATIVE: Ollama (Local LLM)
# ==========================================
# Only used if LLM_PROVIDER=ollama
# Download Ollama from: https://ollama.com/download
# Then run: ollama pull mistral

# Ollama server URL (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Ollama model to use (local)
OLLAMA_MODEL=mistral

# ==========================================
# Optional External APIs
# ==========================================
# OpenWeather API Key for weather tool
# Get your API key from: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# SerpAPI Key for search tool
# Get your API key from: https://serpapi.com/
SERPAPI_API_KEY=your_serpapi_key_here

# ==========================================
# LangSmith Tracing (Optional)
# ==========================================
# Get your API key from: https://smith.langchain.com/
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=react-agent
